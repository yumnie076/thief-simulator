  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'DOEL VAN HET SPEL:

    1. Je tuin ligt vol met grijze vuilniszakken.
    Ruim ze op met de ''Sloop'' knop!

    2. Plaats natuur (bloemen, bomen, water)
    om de tuin egelvriendelijk te maken.

    3. Na 60 seconden wordt het nacht.
    De egel komt langs om te eten en te schuilen.

    4. Help de egel overleven!
    Let op de vos!'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
